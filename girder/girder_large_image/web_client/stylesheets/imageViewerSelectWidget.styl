@import "~nib/index.styl"

.g-item-image-viewer-select
  select
    display inline
    width auto
    margin-left 25px

  .image-viewer-loading
    position relative
    width 0
    height 0

  .image-viewer
    border 1px solid #f0f0f0
    width 100%
    height 600px
    -webkit-touch-callout none
    user-select none
    overflow hidden

    &:focus
      outline none

  #niivue
    position relative

    canvas
      width 100%
      height 100%

  .li-niivue-toolbar
    position absolute
    top 8px
    left 8px
    display flex
    gap 4px
    align-items center
    padding 4px
    border-radius 4px
    background rgba(0, 0, 0, 0.6)
    color #fff
    font 13px sans-serif

    button
      min-width 28px
      height 28px

.g-li-full-screen
  width 100%
  height 100%
  position absolute
  top 0
  left 0
